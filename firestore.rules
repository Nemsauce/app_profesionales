rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role == 'client' || role == 'professional';
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isValidColombianMobileNumber(value) {
      return value is string
        && value.matches('^\\+573[0-9]{9}$');
    }

    function isValidServiceCategory(value) {
      return value is string
        && value in [
          'Carpintería',
          'Plomería',
          'Pintura',
          'Cerrajería',
          'Electricidad',
          'Aires acondicionados',
          'Jardinería',
          'Mudanzas',
          'Limpieza',
          'Reformas',
        ];
    }

    function isValidMainCity(value) {
      return value is string
        && value in [
          'Bogotá',
          'Medellín',
          'Cali',
          'Barranquilla',
          'Cartagena',
          'Bucaramanga',
          'Pereira',
          'Manizales',
          'Cúcuta',
          'Santa Marta',
        ];
    }

    function userRoleAfter(userId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function userRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isClient() {
      return isSignedIn() && userRole(request.auth.uid) == 'client';
    }

    function isActiveProfessional() {
      return resource.data.subscriptionActive == true;
    }

    function validUserCreate(userId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'email',
        'role',
        'createdAt',
      ])
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && isValidRole(request.resource.data.role)
        && request.resource.data.createdAt is timestamp;
    }

    function onlyAllowedUserUpdates() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'updatedAt',
      ])
        && request.resource.data.name is string
        && request.resource.data.updatedAt is timestamp;
    }

    function validClientProfile(userId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'photoUrl',
        'email',
        'city',
      ])
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.photoUrl is string
        && request.resource.data.email is string
        && isValidMainCity(request.resource.data.city);
    }

    function validProfessionalCreate(userId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'email',
        'photoUrl',
        'description',
        'category',
        'city',
        'phoneNumber',
        'whatsappNumber',
        'portfolioPhotos',
        'rating',
        'reviewCount',
        'registrationDate',
        'freeTrialStartDate',
        'freeTrialEndDate',
        'subscriptionStatus',
        'subscriptionActive',
      ])
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.photoUrl is string
        && request.resource.data.description is string
        && isValidServiceCategory(request.resource.data.category)
        && isValidMainCity(request.resource.data.city)
        && isValidColombianMobileNumber(request.resource.data.phoneNumber)
        && isValidColombianMobileNumber(request.resource.data.whatsappNumber)
        && request.resource.data.portfolioPhotos is list
        && request.resource.data.portfolioPhotos.size() == 0
        && request.resource.data.rating is number
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.registrationDate is timestamp
        && request.resource.data.freeTrialStartDate is timestamp
        && request.resource.data.freeTrialEndDate is timestamp
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.subscriptionActive == true;
    }

    function onlyAllowedProfessionalProfileUpdates() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'description',
        'category',
        'city',
        'phoneNumber',
        'whatsappNumber',
        'updatedAt',
      ])
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.description)
        && isValidServiceCategory(request.resource.data.category)
        && isValidMainCity(request.resource.data.city)
        && isValidColombianMobileNumber(request.resource.data.phoneNumber)
        && isValidColombianMobileNumber(request.resource.data.whatsappNumber)
        && request.resource.data.updatedAt is timestamp;
    }

    function validReviewCreate(reviewId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'professionalId',
        'clientId',
        'clientName',
        'rating',
        'comment',
        'createdAt',
      ])
        && request.resource.data.keys().hasAll([
          'id',
          'professionalId',
          'clientId',
          'clientName',
          'rating',
          'comment',
          'createdAt',
        ])
        && request.resource.data.id is string
        && request.resource.data.id == reviewId
        && request.resource.data.clientId is string
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.professionalId is string
        && request.resource.data.professionalId.size() > 0
        && request.resource.data.professionalId != request.auth.uid
        && reviewId == request.auth.uid + '_' + request.resource.data.professionalId
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId));
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validUserCreate(uid);
      allow update: if isOwner(uid) && onlyAllowedUserUpdates();
      allow list, delete: if false;
    }

    match /clients/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && userRoleAfter(uid) == 'client'
        && validClientProfile(uid);
      allow update: if isOwner(uid) && validClientProfile(uid);
      allow list, delete: if false;
    }

    match /professionals/{uid} {
      allow get: if isOwner(uid) || (isSignedIn() && isActiveProfessional());
      allow list: if isSignedIn();
      allow create: if isOwner(uid)
        && userRoleAfter(uid) == 'professional'
        && validProfessionalCreate(uid);
      allow update: if isOwner(uid) && onlyAllowedProfessionalProfileUpdates();
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isClient() && validReviewCreate(reviewId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
